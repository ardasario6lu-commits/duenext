# Public sign-in configuration. Automated tests use local Firebase emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Firebase Admin service-account JSON; never use a NEXT_PUBLIC_ prefix.
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_ADMIN_CREDENTIALS=
# Alternative local ADC: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
APP_ORIGIN=http://localhost:3000
# 32 random bytes, base64; preserve this key when migrating existing encrypted tokens.
TOKEN_KEY=
# Optional Google Calendar: enable only after consent/verification is ready.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Explicit administrator UID; never grant the first signup admin privileges.
SCHOOL_CALENDAR_ADMIN_UID=
# Migration only: original owner of hardcoded legacy personal assignments.
LEGACY_PERSONAL_OWNER_UID=
